# Discord bot token from the Developer Portal
DISCORD_TOKEN=

# The server (guild) this bot manages
GUILD_ID=

# The role that triggers channel creation when assigned (e.g. "Client")
CLIENT_ROLE_ID=

# The category channel ID for "Private 1 on 1's"
PRIVATE_CATEGORY_ID=

# Staff role(s) that should also see every private channel, comma-separated
# e.g. STAFF_ROLE_IDS=111111111111111111,222222222222222222
STAFF_ROLE_IDS=

# Suffix appended to the member's name for the channel, e.g. jake-private
CHANNEL_NAME_SUFFIX=-private

# #general-chat channel ID — posts a welcome message here too. Leave blank to skip.
GENERAL_CHANNEL_ID=

# Optional but recommended: Typeform webhook secret, set when you create the webhook in Typeform
TYPEFORM_WEBHOOK_SECRET=

# Port the webhook server listens on. Render sets this automatically — leave blank.
PORT=
